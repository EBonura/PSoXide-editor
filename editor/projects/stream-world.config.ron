// World-streaming stress world (M8). gen-stream-world turns this into
// editor/projects/stream-world (untracked, regenerate on demand).
// Units are engine units unless noted.
(
    seed: 31,
    grid: (15, 15),
    module_units: 768,
    // bsp_patch_extent written into the World node, authored units (1024 is
    // the cooker's minimum and the densest; 4096 the maximum and the sparsest).
    patch_extent_authored: 2048,
    corridor_pct: 25,
    interior_pct: 20,
    courtyard_pct: 6,
    terrain_pct: 3,
    loop_pct: 3,
    enemy_pct: 35,
    // Rooms with a hook platform (level cap is 32 hook points).
    max_hooks: 12,
    // Minimum spacing between hook rooms, in modules.
    hook_spacing: 4,
    dense: false,
    // Page pool the stress run assumes (see stream_world.rs). The design's
    // own P_world estimate is 213124; the world is about 25x that and about
    // 10x this pool. The seed was picked from a sweep that passes the cook
    // gates with the overrides gen-stream-world writes to stream-cook.ron.
    cook_pool_bytes: 524288,
    shortest_routes: 6,
    random_walks: 8,
    walk_steps: 120,
)
