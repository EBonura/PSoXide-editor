// World-streaming stress world (M8). gen-stream-world turns this into
// editor/projects/stream-world (untracked, regenerate on demand).
// Units are engine units unless noted. See stream_world.rs for what each
// density rule bounds; the pool and the cook parameters are not set here, they
// derive from the guest's measured RAM (brush_region::RAM_BUDGET).
(
    seed: 31,
    grid: (16, 16),
    module_units: 768,
    // The cooker's coarsest surface subdivision (4096 authored = 256 units)
    // and a texture scale that lets it bind (see uv_scale_q8 in the source).
    patch_extent_authored: 4096,
    uv_scale_q8: 512,
    corridor_pct: 20,
    interior_pct: 20,
    courtyard_pct: 8,
    terrain_pct: 6,
    loop_pct: 3,
    enemy_pct: 35,
    // Hook rooms are dead ends (level cap is 32 hook points).
    max_hooks: 12,
    // Minimum spacing between hook rooms, in modules.
    hook_spacing: 4,
    dense: false,
    // Doors per module: bounds how many regions a region sees.
    max_door_degree: 3,
    // Finest terrain patch per module side that the budget allows.
    terrain_cells: 3,
    // Cut target in the cut search's byte model; every module is built under
    // it. Nine sectors holds a 768 unit module with its door walls and
    // vestibules.
    region_target_bytes: 18432,
    // Interior detail a module may add to its shell, same bytes.
    detail_bytes: 1024,
    // RAM scenario: bytes the model pass is assumed to hand the world. Zero is
    // the guest as it is today.
    arena_reclaim_bytes: 0,
    shortest_routes: 6,
    random_walks: 8,
    walk_steps: 120,
)
